{
  "name": "block-analyzer",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "test": "cd apps/api && bun test",
    "test:web": "cd apps/web && tsc && vite build",
    "lint": "cd apps/api && tsc --noEmit"
  }
}
